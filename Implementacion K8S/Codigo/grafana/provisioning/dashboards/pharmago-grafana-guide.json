{
  "id": null,
  "uid": "pharmago-grafana-guide",
  "title": "PharmaGo - Extended Summary",
  "description": "Las 17 fórmulas de la sección Queries Útiles para Dashboards de tutoriales/como-usar-grafana.md, copiadas literalmente. Sin filtros ni cambios de nombres. Incluyen chequeos automáticos y todas las series seleccionadas por la guía. El panel de peticiones activas conserva http_server_active_requests aunque no exista en el entorno.",
  "version": 3,
  "schemaVersion": 38,
  "editable": true,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "pharmago",
    "infra",
    "microservicios",
    "negocio"
  ],
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "title": "Overview original",
      "url": "/d/pharmago-overview",
      "keepTime": true

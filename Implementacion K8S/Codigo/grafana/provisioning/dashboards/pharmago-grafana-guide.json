    {
      "type": "link",
      "title": "Infra original",
      "url": "/d/pharmago-infra",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",

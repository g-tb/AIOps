    },
    {
      "id": 2,
      "title": "Total de peticiones",
      "type": "stat",
      "description": "Consulta literal de como-usar-grafana.md, sección Métricas de Peticiones. No se agregaron filtros ni se modificó la fórmula. Acumulado de los contadores presentes, no incremento del período ni total histórico persistente. La sugerencia del editor de usar rate() cambiaría lo que mide esta tarjeta.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pharmago_http_requests_total)",
          "legendFormat": "Total",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "Sin datos",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },

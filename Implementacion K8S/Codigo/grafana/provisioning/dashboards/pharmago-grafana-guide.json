{
  "id": null,
  "uid": "pharmago-grafana-guide",
  "title": "PharmaGo - Extended Summary",
  "description": "Fórmulas de la sección Queries útiles para Dashboards de tutoriales/como-usar-grafana.md que no repiten el Overview ni el War room. Los percentiles agregan por servicio y miran solo /api, como la alerta de latencia.",
  "version": 3,
  "schemaVersion": 38,
  "editable": true,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "pharmago",
    "infra",
    "microservicios",
    "negocio"
  ],
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "title": "Overview original",
      "url": "/d/pharmago-overview",
      "keepTime": true
    },
    {
      "type": "link",
      "title": "Infra original",
      "url": "/d/pharmago-infra",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Métricas de Peticiones",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Total de peticiones",
      "type": "stat",
      "description": "Consulta literal de como-usar-grafana.md, sección Métricas de Peticiones. No se agregaron filtros ni se modificó la fórmula. Acumulado de los contadores presentes, no incremento del período ni total histórico persistente. La sugerencia del editor de usar rate() cambiaría lo que mide esta tarjeta.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pharmago_http_requests_total)",
          "legendFormat": "Total",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "Sin datos",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Distribución por método HTTP",
      "type": "timeseries",
      "description": "Consulta literal de como-usar-grafana.md, sección Métricas de Peticiones. No se agregaron filtros ni se modificó la fórmula.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(pharmago_http_requests_total[5m]))",
          "legendFormat": "{{method}}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "noValue": "Sin datos",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Métricas de Latencia",
      "type": "row",
      "collapsed": false,
      "panels": [],

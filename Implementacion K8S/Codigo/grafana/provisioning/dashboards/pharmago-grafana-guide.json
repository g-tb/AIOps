    },
    {
      "id": 9,
      "title": "Latencia P50",
      "type": "timeseries",
      "description": "Consulta literal de como-usar-grafana.md, sección Métricas de Latencia. No se agregaron filtros ni se modificó la fórmula. Se conservan las series por sus etiquetas originales, sin agregar entre instancias; los percentiles no son un único percentil global. Unidad: milisegundos.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, exported_job) (rate(pharmago_http_request_duration_milliseconds_bucket{endpoint=~\"/api/.*\"}[5m])))",
